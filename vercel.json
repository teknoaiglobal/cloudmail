{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.cloudflare.com/client/v4/:path*"
    },
    {
      "source": "/creds",
      "destination": "https://token.iismedika.online"
    },
    {
      "source": "/creds/:path*",
      "destination": "https://token.iismedika.online/:path*"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://hayo.teknoaiglobal.com"
        }
      ]
    }
  ]
}
